# server/.env.example
# Purpose: Template for local server env vars. Copy to .env (never commit .env).

# Listen port for the Express BFF
PORT=3001

# Browser origin(s) allowed to call this API (CORS).
# Leave empty locally so Vite on http://localhost:5173 can talk to the BFF.
#
# Comma-separated list, trimmed, no trailing slash. After custom-domain
# cutover, list both www and apex:
# CLIENT_ORIGIN=https://www.getproductrecall.com,https://getproductrecall.com
#
# Before DNS cutover only, the Render static-site origin is enough, e.g.:
# CLIENT_ORIGIN=https://recall-ledger-web.onrender.com
CLIENT_ORIGIN=

# Optional Anthropic key for persona ranking.
# Search still works without it — POST /api/persona-rank then returns { fallback: true }.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
