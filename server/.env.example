# server/.env.example
# Purpose: Template for local server env vars. Copy to .env (never commit .env).

# Listen port for the Express BFF
PORT=3001

# Browser origin allowed to call this API (CORS).
# Leave empty locally so Vite on http://localhost:5173 can talk to the BFF.
# On Render, set to the Static Site URL (no trailing slash), e.g.:
# CLIENT_ORIGIN=https://recall-ledger-web.onrender.com
# Comma-separated list is allowed if you have more than one frontend origin.
CLIENT_ORIGIN=

# Later cards add:
# ANTHROPIC_API_KEY=
# AI_MODEL=
