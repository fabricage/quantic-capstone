# client/.env.example
# Purpose: Template for Vite env vars. Copy to .env (never commit .env).
#
# Empty locally so the Vite dev server proxies /api → Express.
# On Render this is the API origin (no trailing slash), baked in at build time:
#   VITE_API_BASE_URL=https://recall-ledger-api.onrender.com
# After custom-domain cutover this still points at the Render API — not the public site.
VITE_API_BASE_URL=
